-	 */
-	reserved-memory {
-		m3_dump: m3-dump@4da00000 {
-			reg = <0x0 0x4da00000 0x0 0x00100000>;
-			no-map;
-		};
-
-		q6_caldb: q6-caldb@4db00000 {
-			reg = <0x0 0x4db00000 0x0 0x00500000>;
-			no-map;
-		};
-
-		mlo_mem: mlo-global-mem@4e000000 {
-			reg = <0x0 0x4e000000 0x0 0x01200000>;
-			no-map;
-		};
-
-		qcn9274_host_ddr: qcn9274-host-ddr@4f200000 {
-			/* Firmware mode 1 uses 0x02402000 bytes (log-02). Keep
