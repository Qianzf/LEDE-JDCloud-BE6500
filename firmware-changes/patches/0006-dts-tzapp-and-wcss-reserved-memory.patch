--- a/target/linux/qualcommbe/dts/ipq5322-re-cs-06.dts
+++ b/target/linux/qualcommbe/dts/ipq5322-re-cs-06.dts
@@ -226,6 +226,22 @@
 	};
 };
 
+/*
+ * 与 VIKINGYFY/immortalwrt 的 target 保持一致：sbl 与 Q6 保留区
+ * （48 MiB，上游 "reserve 48 MiB for Q6 bring-up"）显式声明，
+ * tzapp 地址修正在 ipq5332-common.dtsi 里完成。
+ */
+&{/reserved-memory} {
+	sbl@4a500000 {
+		reg = <0x0 0x4a500000 0x0 0x00100000>;
+		no-map;
+	};
+};
+
+&q6_region {
+	reg = <0x0 0x4a900000 0x0 0x03000000>;
+};
+
 &wifi0 {
 	qcom,board-id = <22>;
 	nvmem-cells = <&lan_macaddr 2>;
