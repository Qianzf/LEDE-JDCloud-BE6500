# ============================================================
# Docker 运行所需内核选项（RE-CS-06 / qualcommbe-ipq53xx, kernel 6.18）
# 说明：generic/config-6.18 默认关闭 CGROUPS/NAMESPACES，
#      此文件在 LINUX_KCONFIG_LIST 中最后合并，优先级最高。
# ============================================================
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_POSIX_ACL=y
CONFIG_VETH=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_ADVANCED=y

# --- 内核体积控制：HLOS 分区仅 7MiB，必须把 FIT 压到 7168k 以内 ---
# BTF 段在 arm64 Image 中占 4.1MB（压缩后 1.34MB），构建机无需 CO-RE 支持
# CONFIG_KALLSYMS_UNCOMPRESSED is not set
