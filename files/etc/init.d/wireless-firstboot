#!/bin/sh /etc/rc.common
# Make sure the wireless configuration lists every radio this board has.
#
# Nothing else does this on a JDCloud RE-CS-06.  The image ships no
# /etc/config/wireless, and the uci-defaults that used to generate it
# (95-gl-wireless-country) exits immediately unless the board is a
# gl.inet,gl-be9300, so on this board "wifi config" was never executed at all.
# The remaining path, the ieee80211 hotplug handler, never fired in practice.
#
# "wifi config" is idempotent: it starts numbering at the first free radioN and
# only adds sections for phys that are not configured yet, so existing radios
# keep their SSID, key, channel and every other user setting.  Running it on
# every boot is therefore safe and also repairs a config that was generated
# while only some of the phys were registered.
#
# ath12k probes its radios roughly 10-15 s into boot, so the wait would sit in
# front of rcS and delay everything after it (rc.local, the boot LED, the
# "done" state) by that much.  Do the waiting in the background instead: rcS
# finishes immediately and the radios come up as soon as they are ready.

START=99
STOP=01
USE_PROCD=1

# 后台等待射频就绪后生成配置，不阻塞 rcS
wait_and_config() {
	local i=0

	while [ $i -lt 40 ]; do
		[ -n "$(ls /sys/class/ieee80211 2>/dev/null)" ] && break
		sleep 1
		i=$((i + 1))
	done
	[ $i -lt 40 ] || exit 0

	/sbin/wifi config >/dev/null 2>&1
	[ -s /etc/config/wireless ] || exit 0

	ubus call network reload >/dev/null 2>&1
	/sbin/wifi up >/dev/null 2>&1
}

boot() {
	[ -x /sbin/wifi ] || return 0
	wait_and_config &
}

start() { boot; }
