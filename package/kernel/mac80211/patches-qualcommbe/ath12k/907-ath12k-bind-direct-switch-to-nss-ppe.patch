+#define ATH12K_DS_MAX_NODES	4
+#define ATH12K_DS_MAX_BATCH	32
+
+/* nss-ppe hands us a node id; the callbacks below only get that id back. */
+static struct ath12k_ds *ath12k_ds_node_map[ATH12K_DS_MAX_NODES];
+
+static struct ath12k_ds *ath12k_ds_by_node(int node)
+{
+	if (node < 0 || node >= ATH12K_DS_MAX_NODES)
+		return NULL;
+
+	return ath12k_ds_node_map[node];
+}
+
+static u32 ath12k_ds_get_tx_desc_many(int node,
+				      struct ppe_ds_wlan_txdesc_elem *elem,
+				      u32 num_req, u32 buff_size, u32 headroom)
+{
+	struct ath12k_ds_buf_ref refs[ATH12K_DS_MAX_BATCH];
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+	u32 n;
+
+	if (!ds || !elem || !num_req)
+		return 0;
+	if (headroom > ATH12K_DS_HEADROOM) {
+		if (!ds->headroom_warned) {
+			ds->headroom_warned = true;
+			ath12k_warn(ds->dp->ab,
+				    "DS headroom %u exceeds the reserved %u bytes\n",
+				    headroom, ATH12K_DS_HEADROOM);
+		}
+		return 0;
+	}
+	/* nss-dp may ask for more than one batch at a time. */
+	n = 0;
+	while (n < num_req) {
+		u32 chunk = min_t(u32, num_req - n, ARRAY_SIZE(refs));
+		u32 got = ath12k_ds_refill(ds, refs, chunk, buff_size);
+		u32 i;
+
+		for (i = 0; i < got; i++) {
+			elem[n + i].buff_addr = refs[i].addr;
+			elem[n + i].opaque_lo = lower_32_bits(refs[i].cookie);
+			elem[n + i].opaque_hi = upper_32_bits(refs[i].cookie);
+		}
+		n += got;
+		if (got < chunk)
+			break;
+	}
+
+	return n;
+}
+
+static void ath12k_ds_release_tx_desc_single(int node, u32 cookie)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+	u64 full = cookie;
+
+	if (ds)
+		ath12k_ds_release(ds, &full, 1);
+}
+
+static void ath12k_ds_set_tcl_prod_idx(int node, u16 index)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+
+	if (ds)
+		ath12k_ds_tcl_prod(ds, index);
+}
+
+static u16 ath12k_ds_get_tcl_cons_idx(int node)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+
+	return ds ? ath12k_ds_tcl_cons(ds) : 0;
+}
+
+static void ath12k_ds_set_reo_cons_idx(int node, u16 index)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+
+	if (ds)
+		ath12k_ds_reo_cons(ds, index);
+}
+
+static u16 ath12k_ds_get_reo_prod_idx(int node)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+
+	return ds ? ath12k_ds_reo_prod(ds) : 0;
+}
+
+static void ath12k_ds_release_rx_desc(int node,
+				      struct ppe_ds_wlan_rxdesc_elem *arr,
+				      u16 count)
+{
+	struct ath12k_ds *ds = ath12k_ds_by_node(node);
+	u64 cookies[ATH12K_DS_MAX_BATCH];
+	u16 done = 0;
+
+	if (!ds)
+		return;
+	while (done < count) {
+		u16 i, batch = min_t(u16, count - done, ATH12K_DS_MAX_BATCH);
+
+		for (i = 0; i < batch; i++)
+			cookies[i] = arr[done + i].cookie;
+		ath12k_ds_release(ds, cookies, batch);
+		done += batch;
+	}
+}
+
+static void ath12k_ds_enable_tx_consume_intr(int node, bool enable)
+{
+}
+
+static void ath12k_ds_notify_napi_done(int node)
+{
+}
+
+static u8 ath12k_ds_get_wlan_arch_mode(void)
+{
+	return 7;
+}
+
+static const struct ppe_ds_wlan_ops ath12k_ds_wlan_ops = {
+	.get_tx_desc_many = ath12k_ds_get_tx_desc_many,
+	.release_tx_desc_single = ath12k_ds_release_tx_desc_single,
+	.set_tcl_prod_idx = ath12k_ds_set_tcl_prod_idx,
+	.set_reo_cons_idx = ath12k_ds_set_reo_cons_idx,
+	.get_tcl_cons_idx = ath12k_ds_get_tcl_cons_idx,
+	.get_reo_prod_idx = ath12k_ds_get_reo_prod_idx,
+	.release_rx_desc = ath12k_ds_release_rx_desc,
+	.enable_tx_consume_intr = ath12k_ds_enable_tx_consume_intr,
+	.notify_napi_done = ath12k_ds_notify_napi_done,
+	.get_wlan_arch_mode = ath12k_ds_get_wlan_arch_mode,
 };
 
+static bool ath12k_ds_available(void)
+{
+	return true;
+}
+
+static void ath12k_ds_nss_sync(struct ath12k_ds *ds)
+{
+}
+
+static struct ppe_ds *
+ath12k_ds_nss_register(struct ath12k_ds *ds, ppe_ds_wlan_node_type_t node_type,
+		       dma_addr_t tcl, dma_addr_t reo, u32 count)
+{
+	struct ppe_ds_wlan_arch_reg_info info = {};
+	struct ppe_ds *node;
+	u32 id;
+	int ret;
+
+	node = ppe_ds_wlan_inst_alloc((struct ppe_ds_wlan_ops *)&ath12k_ds_wlan_ops, 0);
+	if (!node)
+		return ERR_PTR(-ENODEV);
+	id = ppe_ds_get_node_id(node);
+	if (id >= ATH12K_DS_MAX_NODES) {
+		ppe_ds_wlan_inst_free(node);
+		return ERR_PTR(-ENOSPC);
+	}
+	ath12k_ds_node_map[id] = ds;
+
+	info.node_type = node_type;
+	info.dp_ppeds_node_id = id;
+	info.wifi_arch_mode = ath12k_ds_get_wlan_arch_mode();
+	info.wifi7_cfg.ppe2tcl_ba = tcl;
+	info.wifi7_cfg.reo2ppe_ba = reo;
+	info.wifi7_cfg.ppe2tcl_num_desc = count;
+	info.wifi7_cfg.reo2ppe_num_desc = count;
+	if (!ppe_ds_wlan_inst_register_arch_mode_wifi7(node, &info)) {
+		ath12k_ds_node_map[id] = NULL;
+		ppe_ds_wlan_inst_free(node);
+		return ERR_PTR(-EIO);
+	}
+
+	/* nss-ppe reports where the PPE side starts in each ring; the WMAC rings
+	 * must start at the same index or both sides desynchronise immediately.
+	 */
+	ret = ath12k_ds_start_indices(ds, info.wifi7_cfg.ppe2tcl_start_idx,
+				      info.wifi7_cfg.reo2ppe_start_idx);
+	if (ret) {
+		ath12k_ds_node_map[id] = NULL;
+		ppe_ds_wlan_inst_free(node);
+		return ERR_PTR(ret);
+	}
+
+	return node;
+}
+
+static int ath12k_ds_nss_unregister(struct ath12k_ds *ds)
+{
+	u32 id;
+
+	if (!ds->handle)
+		return 0;
+	id = ppe_ds_get_node_id(ds->handle);
+	if (id < ATH12K_DS_MAX_NODES)
+		ath12k_ds_node_map[id] = NULL;
+	ppe_ds_wlan_inst_free(ds->handle);
+	ds->handle = NULL;
+
+	return 0;
+}
+
+static int ath12k_ds_nss_start(struct ath12k_ds *ds)
+{
+	int ret;
+
+	if (!ds->handle)
+		return -ENODEV;
+
+	ret = ppe_ds_wlan_instance_start(ds->handle, &ds->ctx);
+	if (ret)
+		return ret;
+	/* Clear EDMA_PPEDS_SERVICE_STOP_BIT so the ppeds service runs. */
+	ppe_ds_wlan_service_status_update(ds->handle, false);
+
+	return 0;
+}
+
+static int ath12k_ds_nss_stop(struct ath12k_ds *ds)
+{
+	if (!ds->handle)
+		return -ENODEV;
+	/* Ask the EDMA side to stop servicing this node first. */
+	ppe_ds_wlan_service_status_update(ds->handle, true);
+	ppe_ds_wlan_instance_stop(ds->handle, &ds->ctx);
+
+	return 0;
+}
+
+/* qca-nss-ppe only direct-switches flows whose VP carries a core mask; with
+ * core_mask == 0 the flow falls back to PPE_DRV_SC_VP_RPS, i.e. to the CPU.
+ * Mirror the masks qca-nss-ppe itself defaults to (cpu_mask_2g = 0x2,
+ * cpu_mask_5g_lo = 0x1).
+ */
+static u8 ath12k_ds_core_mask(struct ath12k_ds *ds)
+{
+	return ds->dp->ab->hif.bus == ATH12K_BUS_AHB ? 0x2 : 0x1;
+}
+
+static int ath12k_ds_nss_vp_alloc(struct ath12k_ds *ds, struct net_device *dev)
+{
+	struct ppe_vp_ai vpai = {};
+
+	vpai.usr_type = PPE_VP_USER_TYPE_DS;
+	vpai.net_dev_type = PPE_VP_NET_DEV_TYPE_WIFI;
+	vpai.core_mask = ath12k_ds_core_mask(ds);
+	vpai.status = PPE_VP_STATUS_SUCCESS;
+	/* ppe_ds_wlan_vp_alloc() would need the internal ppe_ds_wlan_handle_t;
+	 * ppe_vp_alloc() is the same path and is exported directly.
+	 */
+	return ppe_vp_alloc(dev, &vpai);
+}
+
+static int ath12k_ds_nss_vp_route(struct ath12k_ds *ds, int port, bool direct)
+{
+	struct ppe_vp_ui ui = {};
+
+	if (port < 0)
+		return -ENODEV;
+	if (direct) {
+		ui.usr_type = PPE_VP_USER_TYPE_DS;
+		ui.core_mask = ath12k_ds_core_mask(ds);
+	} else {
+		ui.usr_type = PPE_VP_USER_TYPE_NONE;
+		ui.core_mask = 0;
+	}
+	/* nss-ppe only applies usr_type when core_mask is part of the update. */
+	ui.update_flags = PPE_VP_UPDATE_FLAG_VP_USR_TYPE |
+			  PPE_VP_UPDATE_FLAG_VP_CORE_MASK;
+
+	return ppe_vp_cfg_update(port, &ui);
+}
+
+static int ath12k_ds_nss_vp_free(struct ath12k_ds *ds, int port)
+{
+	if (port < 0)
+		return 0;
+
+	return ppe_vp_free(port);
+}
