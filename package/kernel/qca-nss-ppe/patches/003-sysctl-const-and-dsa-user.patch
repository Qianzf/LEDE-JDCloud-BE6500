From: Qianzf <qianzf@example.com>
Subject: [PATCH] qca-nss-ppe: 6.18 sysctl and DSA API changes

- proc/sysctl handlers take a const struct ctl_table pointer since 6.18
- dsa_slave_dev_check() was renamed dsa_user_dev_check()

Signed-off-by: Qianzf <qianzf@example.com>
---
diff -ru ppe2/drv/ppe_drv/ppe_drv.c ppe3/drv/ppe_drv/ppe_drv.c
--- a/drv/ppe_drv/ppe_drv.c	2026-11-21 12:29:44.054110038 +0800
+++ b/drv/ppe_drv/ppe_drv.c	2026-11-21 12:31:34.773631412 +0800
@@ -313,7 +313,7 @@
  * ppe_drv_sixth_tuple_mode_handler()
  *	change the sixth mode.
  */
-static int ppe_drv_sixth_tuple_mode_handler(struct ctl_table *table, int write,
+static int ppe_drv_sixth_tuple_mode_handler(const struct ctl_table *table, int write,
 		void __user *buffer, size_t *lenp, loff_t *ppos)
 {
 	int ret, cur_sixth_tuple_mode;
@@ -2998,7 +2998,7 @@
  * ppe_drv_if_bm_to_offload_handler()
  *	API to configure the interface bitmask where the offload is enabled
  */
-static int ppe_drv_if_bm_to_offload_handler(struct ctl_table *table, int write,
+static int ppe_drv_if_bm_to_offload_handler(const struct ctl_table *table, int write,
 		void __user *buffer, size_t *lenp, loff_t *ppos)
 {
 	int ret;
@@ -3032,7 +3032,7 @@
  * ppe_drv_disable_port_mtu_check_handler()
  * 	Set disable port mtu config
  */
-static int ppe_drv_disable_port_mtu_check_handler(struct ctl_table *table,
+static int ppe_drv_disable_port_mtu_check_handler(const struct ctl_table *table,
 						int write, void __user *buffer,
 						size_t *lenp, loff_t *ppos)
 {
@@ -3055,7 +3055,7 @@
  * ppe_drv_l4_checksum_exception_enable()
  *	API to enable/disable the exception for l4 checksum.
  */
-int ppe_drv_l4_checksum_exception_enable(struct ctl_table *table, int write,
+int ppe_drv_l4_checksum_exception_enable(const struct ctl_table *table, int write,
 		void __user *buffer, size_t *lenp, loff_t *ppos)
 {
 	int ret;
@@ -3092,7 +3092,7 @@
  * ppe_drv_mac_lrn_exception_en()
  *	API to enable/disable the exception for MAC address learn exception.
  */
-int ppe_drv_mac_lrn_exception_en(struct ctl_table *table, int write,
+int ppe_drv_mac_lrn_exception_en(const struct ctl_table *table, int write,
 		void __user *buffer, size_t *lenp, loff_t *ppos)
 {
 	int ret;
@@ -3112,7 +3112,7 @@
  * ppe_drv_loopback_port_feature_write_handler()
  *	sysctl handler for loopback port write operation.
  */
-static int ppe_drv_loopback_port_feature_write_handler(struct ctl_table *table, int write,
+static int ppe_drv_loopback_port_feature_write_handler(const struct ctl_table *table, int write,
 		void __user *buffer, size_t *lenp, loff_t *ppos)
 {
 	struct ppe_drv *p = ppe_drv_gbl;
@@ -3167,7 +3167,7 @@
