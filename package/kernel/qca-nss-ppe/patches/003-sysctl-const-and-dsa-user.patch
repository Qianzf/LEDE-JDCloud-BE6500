 #if defined(NSS_VLAN_BASED_DSA_SUPPORT) || defined(NSS_ATH_HDR_BASED_DSA_SUPPORT)
-		is_dsa_dev = dsa_slave_dev_check(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VIRTUAL);
+		is_dsa_dev = dsa_user_dev_check(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VIRTUAL);
 #endif
 	}
 
@@ -1022,7 +1022,7 @@
 		is_vlan_as_vp = is_vlan_dev(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VIRTUAL);
 		is_vlan_as_veip = is_vlan_dev(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VEIP);
 #if defined(NSS_VLAN_BASED_DSA_SUPPORT) || defined(NSS_ATH_HDR_BASED_DSA_SUPPORT)
-		is_dsa_dev = dsa_slave_dev_check(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VIRTUAL);
+		is_dsa_dev = dsa_user_dev_check(iface_tx->dev) && (iface_tx->type == PPE_DRV_IFACE_TYPE_VIRTUAL);
 #endif
 	}
 
diff -ru ppe2/drv/ppe_drv/ppe_drv_port.c ppe3/drv/ppe_drv/ppe_drv_port.c
--- a/drv/ppe_drv/ppe_drv_port.c	2026-08-10 23:31:55.000000000 +0800
+++ b/drv/ppe_drv/ppe_drv_port.c	2026-11-21 12:31:34.726594193 +0800
@@ -1647,7 +1647,7 @@
 	}
 
 #if defined(NSS_VLAN_BASED_DSA_SUPPORT) || defined(NSS_ATH_HDR_BASED_DSA_SUPPORT)
-	if ((pp->type == PPE_DRV_PORT_VIRTUAL) && dsa_slave_dev_check(pp->dev)) {
+	if ((pp->type == PPE_DRV_PORT_VIRTUAL) && dsa_user_dev_check(pp->dev)) {
 		profile = PPE_DRV_REDIR_PROFILE_ID;
 	}
 #endif
diff -ru ppe2/drv/ppe_drv/ppe_drv_v4.c ppe3/drv/ppe_drv/ppe_drv_v4.c
