From: Qianzf <qianzf@example.com>
Subject: [PATCH] qca-ssdk: replace the removed strlcpy/strlcat helpers

Linux 6.13+ removed strlcpy()/strlcat(). Use strscpy() and a local
append helper for the UCI/CLI string handling.

Signed-off-by: Qianzf <qianzf@example.com>
---
diff -ru sdknew/app/nathelper/linux/host_helper.c sdkstr2/app/nathelper/linux/host_helper.c
--- a/app/nathelper/linux/host_helper.c	2026-07-20 11:22:55.000000000 +0800
+++ b/app/nathelper/linux/host_helper.c	2026-11-21 10:27:12.136244462 +0800
@@ -16,6 +16,17 @@
 #ifdef KVER32
 #include <linux/kconfig.h>
 #include <linux/version.h>
+
+/* Linux 6.13+ dropped strscpy()/ssdk_strlcat() from the kernel API */
+static inline size_t ssdk_strlcat(char *dst, const char *src, size_t size)
+{
+	size_t dlen = strnlen(dst, size);
+
+	if (dlen == size)
+		return size + strlen(src);
+
+	return dlen + strscpy(dst + dlen, src, size - dlen);
+}
 #include <generated/autoconf.h>
 #else
 #include <linux/autoconf.h>
@@ -784,8 +795,8 @@
             /* Get bridge interface name */
             br_name = (char *)(br_port_get_rcu(nat_dev)->br->dev->name);
             if (!is_wan) {
-                strlcat (nat_lan_dev_list, " ", sizeof(nat_lan_dev_list));
-                strlcat (nat_lan_dev_list, br_name, sizeof(nat_lan_dev_list));
+                ssdk_strlcat (nat_lan_dev_list, " ", sizeof(nat_lan_dev_list));
+                ssdk_strlcat (nat_lan_dev_list, br_name, sizeof(nat_lan_dev_list));
             }
             /* Get dmac */
             devmac = (uint8_t *)(br_port_get_rcu(nat_dev)->br->dev->dev_addr);
@@ -1268,7 +1279,7 @@
         return 0;
     }
 
-    strlcpy(temp, dev_list, sizeof(temp));
+    strscpy(temp, dev_list, sizeof(temp));
     list = temp;
 
     while ((list_dev = strsep(&list, " ")) != NULL)
@@ -1314,7 +1325,7 @@
 	memset(&msg, 0, sizeof(msg));
 	msg.arp_in.ip = *((uint32_t *)neigh->primary_key);
 	memcpy(msg.arp_in.mac, neigh->ha, ETH_ALEN);
-	strlcpy(msg.arp_in.name, neigh->dev->name, IFNAMSIZ);
+	strscpy(msg.arp_in.name, neigh->dev->name, IFNAMSIZ);
 	msg.arp_in.in = neigh->dev;
 
 	if (neigh->dev->priv_flags & IFF_EBRIDGE) {
