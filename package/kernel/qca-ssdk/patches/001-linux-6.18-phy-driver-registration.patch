From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] qca-ssdk: use the array-based PHY driver helpers on 6.18

Linux 6.18 removed phy_driver_register()/phy_driver_unregister().
Ported from the ipq40xx qca-ssdk 6.18 fix to the QSDK 14.0 source.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/src/hsl/phy/sfp_phy.c	2026-07-20 11:22:55.000000000 +0800
+++ b/src/hsl/phy/sfp_phy.c	2026-11-21 08:07:02.530864343 +0800
@@ -674,7 +674,11 @@
 	int ret = 0;
 	if(sfp_phy_drv_registered == A_FALSE)
 	{
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+		ret = phy_drivers_register(&sfp_phy_driver, 1, THIS_MODULE);
+#else
 		ret = phy_driver_register(&sfp_phy_driver, THIS_MODULE);
+#endif
 		sfp_phy_drv_registered = A_TRUE;
 	}
 	return ret;
@@ -684,7 +688,11 @@
 {
 	if (sfp_phy_drv_registered == A_TRUE)
 	{
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+		phy_drivers_unregister(&sfp_phy_driver, 1);
+#else
 		phy_driver_unregister(&sfp_phy_driver);
+#endif
 		sfp_phy_drv_registered = A_FALSE;
 	}
 }
